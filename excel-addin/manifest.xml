<?xml version="1.0" encoding="UTF-8"?>
<!--
  Lattice117 Schedule Check — Excel task pane add-in.

  Office refuses to load a task pane over plain http from anything but
  localhost, so the add-in is served from GitHub Pages. The Pages workflow
  publishes this folder to https://kabcttrhc.github.io/lattice117-verify/excel-addin
  on every push to main; enable it once under Settings -> Pages -> Source ->
  GitHub Actions.

  Sideload:
    Save this file somewhere, then in Excel
      File -> Options -> Trust Center -> Trust Center Settings
           -> Trusted Add-in Catalogs -> add the folder holding this file
           -> tick "Show in Menu" -> restart Excel
           -> Insert -> My Add-ins -> Shared Folder -> Schedule Check

  To develop against a local server instead, replace every
  https://kabcttrhc.github.io/lattice117-verify/excel-addin below with
  https://localhost:3000 and run:  cd excel-addin && npx http-server -S -p 3000
  (Office requires TLS even locally; -S makes http-server generate a cert.)
-->
<OfficeApp
    xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
    xmlns:ov="http://schemas.microsoft.com/office/taskpaneappversionoverrides"
    xsi:type="TaskPaneApp">

  <!-- The add-in's identity. Two listings sharing one Id collide, so this is
       generated once per published add-in and then never changed — changing it
       makes every existing install look like a different add-in. -->
  <Id>c37d5590-205e-44a0-94dc-ee35ce9aae95</Id>
  <Version>0.2.0.0</Version>
  <ProviderName>Brierley Sovereign Group Ltd</ProviderName>
  <DefaultLocale>en-GB</DefaultLocale>
  <DisplayName DefaultValue="Lattice117 Schedule Check"/>
  <Description DefaultValue="Checks whether your rounds can be run against their own time windows, and whether your rota meets 11h rest and 20m break thresholds. Names what breaks and by how much. Runs entirely inside Excel - nothing is uploaded."/>
  <IconUrl DefaultValue="https://kabcttrhc.github.io/lattice117-verify/excel-addin/assets/icon-32.png"/>
  <HighResolutionIconUrl DefaultValue="https://kabcttrhc.github.io/lattice117-verify/excel-addin/assets/icon-80.png"/>
  <SupportUrl DefaultValue="https://kabcttrhc.github.io/lattice117-verify/excel-addin/support.html"/>

  <AppDomains>
    <AppDomain>https://kabcttrhc.github.io</AppDomain>
  </AppDomains>

  <Hosts>
    <Host Name="Workbook"/>
  </Hosts>

  <Requirements>
    <Sets DefaultMinVersion="1.1">
      <Set Name="ExcelApi" MinVersion="1.1"/>
    </Sets>
  </Requirements>

  <DefaultSettings>
    <SourceLocation DefaultValue="https://kabcttrhc.github.io/lattice117-verify/excel-addin/taskpane.html"/>
  </DefaultSettings>

  <!-- ReadWriteDocument, not ReadDocument: the add-in colours the failing
       rows in the sheet so the result is visible where the planner is
       already looking, not only in the pane. -->
  <Permissions>ReadWriteDocument</Permissions>

  <VersionOverrides xmlns="http://schemas.microsoft.com/office/taskpaneappversionoverrides" xsi:type="VersionOverridesV1_0">
    <Hosts>
      <Host xsi:type="Workbook">
        <DesktopFormFactor>
          <GetStarted>
            <Title resid="GetStarted.Title"/>
            <Description resid="GetStarted.Description"/>
            <LearnMoreUrl resid="GetStarted.LearnMoreUrl"/>
          </GetStarted>

          <ExtensionPoint xsi:type="PrimaryCommandSurface">
            <OfficeTab id="TabHome">
              <Group id="L117.Group">
                <Label resid="L117.Group.Label"/>
                <Icon>
                  <bt:Image size="16" resid="Icon.16"/>
                  <bt:Image size="32" resid="Icon.32"/>
                  <bt:Image size="80" resid="Icon.80"/>
                </Icon>
                <Control xsi:type="Button" id="L117.OpenPane">
                  <Label resid="L117.OpenPane.Label"/>
                  <Supertip>
                    <Title resid="L117.OpenPane.Label"/>
                    <Description resid="L117.OpenPane.Tip"/>
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="Icon.16"/>
                    <bt:Image size="32" resid="Icon.32"/>
                    <bt:Image size="80" resid="Icon.80"/>
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <TaskpaneId>L117.Taskpane</TaskpaneId>
                    <SourceLocation resid="Taskpane.Url"/>
                  </Action>
                </Control>
              </Group>
            </OfficeTab>
          </ExtensionPoint>
        </DesktopFormFactor>
      </Host>
    </Hosts>

    <Resources>
      <bt:Images>
        <bt:Image id="Icon.16" DefaultValue="https://kabcttrhc.github.io/lattice117-verify/excel-addin/assets/icon-16.png"/>
        <bt:Image id="Icon.32" DefaultValue="https://kabcttrhc.github.io/lattice117-verify/excel-addin/assets/icon-32.png"/>
        <bt:Image id="Icon.80" DefaultValue="https://kabcttrhc.github.io/lattice117-verify/excel-addin/assets/icon-80.png"/>
      </bt:Images>
      <bt:Urls>
        <bt:Url id="Taskpane.Url" DefaultValue="https://kabcttrhc.github.io/lattice117-verify/excel-addin/taskpane.html"/>
        <bt:Url id="GetStarted.LearnMoreUrl" DefaultValue="https://github.com/KABCTTRHC/lattice117-verify"/>
      </bt:Urls>
      <bt:ShortStrings>
        <bt:String id="L117.Group.Label" DefaultValue="Lattice117"/>
        <bt:String id="L117.OpenPane.Label" DefaultValue="Schedule Check"/>
        <bt:String id="GetStarted.Title" DefaultValue="Lattice117 Schedule Check is ready."/>
      </bt:ShortStrings>
      <bt:LongStrings>
        <bt:String id="L117.OpenPane.Tip" DefaultValue="Check whether the rounds in this sheet can actually be run against their own time windows."/>
        <bt:String id="GetStarted.Description" DefaultValue="Select your route rows and choose Schedule Check on the Home tab. Nothing leaves this workbook."/>
      </bt:LongStrings>
    </Resources>
  </VersionOverrides>
</OfficeApp>
