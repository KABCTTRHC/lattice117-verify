{
  "name": "lattice117-verify",
  "version": "0.3.0",
  "description": "Deterministic schedule feasibility verification. Checks whether a planned route holds against its own time windows and names the exact violation when it does not. Includes lattice117-mcp, a Model Context Protocol server over stdio for AI agents. Runs entirely locally — no network, no server, no telemetry.",
  "keywords": [
    "scheduling",
    "vrptw",
    "verification",
    "logistics",
    "routing",
    "feasibility",
    "fixed-point",
    "deterministic",
    "wasm",
    "webassembly",
    "rota",
    "staff-rota",
    "shift-compliance",
    "working-time-regulations",
    "wtr",
    "rest-period",
    "route-sheet",
    "time-windows",
    "delivery-windows",
    "offline-first",
    "mcp",
    "model-context-protocol",
    "ai-agents",
    "capacity"
  ],
  "license": "AGPL-3.0-or-later",
  "author": "Brierley Sovereign Group Ltd",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KABCTTRHC/lattice117-verify.git"
  },
  "homepage": "https://github.com/KABCTTRHC/lattice117-verify",
  "type": "module",
  "main": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    }
  },
  "files": [
    "bin/lattice117-verify.mjs",
    "index.js",
    "index.d.ts",
    "digest.js",
    "resequence.js",
    "bin/lattice117-mcp.mjs",
    "mcp.js",
    "rota.js",
    "toolpath.js",
    "lattice117_wasm.wasm",
    "example-route-sheet.csv",
    "example-fleet-nottingham.csv",
    "example-fleet-nottingham-matrix.txt",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "sideEffects": false,
  "bin": {
    "lattice117-verify": "./bin/lattice117-verify.mjs",
    "lattice117-mcp": "./bin/lattice117-mcp.mjs"
  },
  "scripts": {
    "reproduce": "node bin/lattice117-verify.mjs",
    "prepublishOnly": "node bin/lattice117-verify.mjs reproduce",
    "mcp": "node bin/lattice117-mcp.mjs"
  }
}
